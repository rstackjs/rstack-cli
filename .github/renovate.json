{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>rstackjs/renovate"],
  "packageRules": [
    {
      "description": "Show core version changes from the root catalog in scoped update titles",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@rsbuild/*", "@rslib/*", "@rslint/*", "@rstest/*"],
      "groupSingleUpdates": true,
      "commitMessageExtra": "",
      "group": {
        "commitMessageTopic": "{{{groupName}}}{{#each upgrades}}{{#if (and (equals packageFile \"pnpm-workspace.yaml\") (equals (lookup (split depName \"/\") 1) \"core\"))}} ({{{depName}}} {{#if currentVersion}}{{{currentVersion}}}{{else}}{{{currentValue}}}{{/if}} -> {{{newVersion}}}){{/if}}{{/each}}"
      }
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@rsbuild/*"],
      "groupName": "@rsbuild packages",
      "groupSlug": "rsbuild",
      "automerge": true
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@rslib/*"],
      "groupName": "@rslib packages",
      "groupSlug": "rslib",
      "automerge": true
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@rslint/*"],
      "groupName": "@rslint packages",
      "groupSlug": "rslint",
      "automerge": true
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@rstest/*"],
      "groupName": "@rstest packages",
      "groupSlug": "rstest",
      "automerge": true
    },
    {
      "description": "Update unscoped rstack runtime dependencies individually",
      "matchManagers": ["npm"],
      "matchPackageNames": ["prettier", "tinypool", "yuku-parser"],
      "groupName": null,
      "groupSlug": null,
      "automerge": true
    },
    {
      "description": "Disable Rust toolchain updates",
      "matchManagers": ["rust-toolchain"],
      "enabled": false
    },
    {
      "description": "Disable TypeScript updates in Svelte and Vue templates until svelte-check, svelte2tsx, and vue-tsc support TypeScript 7",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"],
      "matchFileNames": [
        "packages/create-rstack/template-app-svelte-ts/package.json",
        "packages/create-rstack/template-app-vue-ts/package.json",
        "packages/create-rstack/template-lib-svelte-ts/package.json",
        "packages/create-rstack/template-lib-vue-ts/package.json"
      ],
      "enabled": false
    }
  ]
}
