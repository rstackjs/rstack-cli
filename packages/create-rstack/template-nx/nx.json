{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      { "fileset": "{projectRoot}/.{env*,*.env}", "includeIgnored": true },
      "sharedGlobals"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/rstack.config.ts",
      "{workspaceRoot}/pnpm-workspace.yaml",
      { "fileset": "{workspaceRoot}/.{env*,*.env}", "includeIgnored": true }
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["default", "^default"],
      "outputs": ["{projectRoot}/dist"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "continuous": true
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["default", "^default"]
    }
  }
}
