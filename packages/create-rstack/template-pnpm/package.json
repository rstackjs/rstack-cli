{
  "name": "rstack-pnpm",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "check": "rs check --type-check",
    "dev": "pnpm --filter \"./packages/**\" build && pnpm -r --parallel dev",
    "format": "rs fmt",
    "lint": "rs lint",
    "test": "pnpm --filter \"./packages/**\" build && pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "rstack": "^0.9.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.16.1"
}
